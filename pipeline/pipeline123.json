{
	"name": "pipeline123",
	"properties": {
		"activities": [
			{
				"name": "get sourcefiles",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_blob_source_new",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "get destfiles",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_blob_dest_new",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "count of source files",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "get sourcefiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "sourcefilecount",
					"value": {
						"value": "@{length(activity('get sourcefiles').output.childItems)}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "count of dest files",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "get destfiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "destfilecount",
					"value": {
						"value": "@{length(activity('get destfiles').output.childItems)}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "missed files",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "count of source files",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "count of dest files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "missedfilescount",
					"value": {
						"value": "@{sub(\n    int(variables('sourcefilecount')),\n    int(variables('destfilecount'))\n    )\n    }",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "missed files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('missedfilescount'),0)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Filter1",
							"type": "Filter",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"items": {
									"value": "@activity('get sourcefiles').output.childItems",
									"type": "Expression"
								},
								"condition": {
									"value": "@not(contains(activity('get destfiles').output.childItems,item()))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Execute Pipeline1",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Filter1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pipeline14",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"missedfilesnames": {
										"value": "@activity('Filter1').output.value",
										"type": "Expression"
									}
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Wait1",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					]
				}
			}
		],
		"variables": {
			"sourcefilecount": {
				"type": "String"
			},
			"destfilecount": {
				"type": "String"
			},
			"missedfilescount": {
				"type": "String"
			}
		},
		"annotations": []
	}
}