							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "varx",
							"value": 5
						}
					},
					{
						"name": "Set variablez",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Set variablex",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "varz",
							"value": {
								"value": "@add(variables('varx'),variables('vary'))",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"varx": {
						"type": "Integer"
					},
					"vary": {
						"type": "Integer",
						"defaultValue": 10
					},
					"varz": {
						"type": "Integer"
					}
