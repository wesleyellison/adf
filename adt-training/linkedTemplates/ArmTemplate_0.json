										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "varx",
										"value": {
											"value": "@{add(int(variables('temp')),1)}",
											"type": "Expression"
										}
									}
								}
							],
							"timeout": "0.12:00:00"
						}
					}
